{
  "manifest_version": 3,
  "name": "Gold & Silver Rate",
  "version": "1.4.1",
  "description": "India-wide daily gold and silver benchmark rates with historical price charts.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gold & Silver Rate"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://snapdata.dev/*"
  ],
  "icons": {
    "16": "assets/logo-128.png",
    "32": "assets/logo-128.png",
    "48": "assets/logo-128.png",
    "128": "assets/logo-128.png"
  }
}
